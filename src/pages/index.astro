---
import Base from '../layouts/Base.astro';

const treats = [
  {
    number: '01',
    name: 'Celebration cakes',
    description: 'The centrepiece for birthdays, milestones and the days worth remembering.',
    image: 'https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=1000&q=85',
    alt: 'Layered celebration cake with decorative frosting',
    tag: 'Made to order',
  },
  {
    number: '02',
    name: 'Cupcakes',
    description: 'Little individual cakes, finished with a generous swirl of buttercream.',
    image: 'https://images.unsplash.com/photo-1486427944299-d1955d23e34d?auto=format&fit=crop&w=1000&q=85',
    alt: 'Decorated cupcakes arranged together',
    tag: 'For sharing',
  },
  {
    number: '03',
    name: 'Cookies',
    description: 'The kind of treat that makes a coffee break worth looking forward to.',
    image: 'https://images.unsplash.com/photo-1499636136210-6f4ee915583e?auto=format&fit=crop&w=1000&q=85',
    alt: 'Freshly baked chocolate chip cookies',
    tag: 'Small batches',
  },
  {
    number: '04',
    name: 'Brownies & bars',
    description: 'Rich, chocolatey squares for when something a little indulgent is in order.',
    image: 'https://images.unsplash.com/photo-1606313564200-e75d5e30476c?auto=format&fit=crop&w=1000&q=85',
    alt: 'Chocolate brownies cut into squares',
    tag: 'A little treat',
  },
];
---

<Base title="LiaBakes SG — A little something homemade">
  <div class="announcement">
    <span>HOME-BAKED IN SINGAPORE</span>
    <span class="announcement-dot" aria-hidden="true">✳</span>
    <span>MADE FOR YOUR EVERYDAY CELEBRATIONS</span>
  </div>

  <header class="site-header" id="top">
    <a class="wordmark" href="#top" aria-label="LiaBakes home">lia<span>bakes</span><i>.</i></a>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="site-nav">
      <span></span><span></span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Main navigation">
      <a href="#story">Our little story</a>
      <a href="#bakes">The bakes</a>
      <a class="nav-cta" href="#order">Let's talk cake <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span> A LITTLE BAKERY, A LOT OF HEART</p>
        <h1>Good things<br />come <em>fresh</em><br />from the oven.</h1>
        <p class="hero-description">Thoughtful little bakes for birthdays, get-togethers, and the perfectly ordinary Tuesday that deserves a treat.</p>
        <div class="hero-actions">
          <a class="button button-dark" href="#bakes">Take a look <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="https://www.instagram.com/liabakes_sg/" target="_blank" rel="noopener noreferrer">Find us on Instagram <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-footnote"><span class="asterisk">✳</span> Baked with care in Singapore</div>
      </div>
      <div class="hero-visual">
        <div class="hero-photo-wrap">
          <img class="hero-photo" src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=1400&q=90" alt="A beautifully finished celebration cake" fetchpriority="high" />
          <div class="photo-stamp"><span>made</span><strong>with</strong><span>love</span><i>✳</i></div>
        </div>
        <div class="hero-caption"><span>THE SWEETEST PART OF THE DAY</span><span>01 / 04</span></div>
        <span class="hero-side-note">A little sweetness goes a long way.</span>
      </div>
      <div class="hero-index" aria-hidden="true">01 — 04</div>
    </section>

    <section class="intro section-pad" id="story">
      <div class="section-kicker"><span>01</span><span>THE STORY</span></div>
      <div class="intro-grid">
        <h2>Not just a<br />sweet tooth.<br /><em>A soft spot.</em></h2>
        <div class="intro-copy">
          <p class="intro-lead">Some of the best moments happen around a table, with something lovely in the middle of it.</p>
          <p>LiaBakes is a home-baking project based in Singapore, making treats for the little celebrations and everyday moments that bring people together. Each order is prepared with care, because the details matter and sharing something homemade should feel special.</p>
          <a class="underlined-link" href="https://www.instagram.com/liabakes_sg/" target="_blank" rel="noopener noreferrer">A peek behind the scenes <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="intro-mark" aria-hidden="true">L.</div>
    </section>

    <section class="bakes section-pad" id="bakes">
      <div class="section-kicker"><span>02</span><span>FRESH FROM THE KITCHEN</span></div>
      <div class="bakes-heading">
        <h2>A few of our<br /><em>favourite things.</em></h2>
        <p>Made to order, made to be shared. Have something else in mind? Tell us what you're dreaming up.</p>
      </div>
      <div class="treat-grid">
        {treats.map((treat) => (
          <article class="treat-card">
            <a class="treat-image" href="#order" aria-label={`Ask about ${treat.name}`}>
              <img src={treat.image} alt={treat.alt} loading="lazy" />
              <span class="treat-number">{treat.number}</span>
              <span class="treat-arrow" aria-hidden="true">↗</span>
            </a>
            <div class="treat-meta"><h3>{treat.name}</h3><span>{treat.tag}</span></div>
            <p>{treat.description}</p>
          </article>
        ))}
      </div>
      <p class="menu-disclaimer">A little note: the selection may change. Follow along on Instagram for current bakes and availability.</p>
    </section>

    <section class="note-band">
      <span class="note-star" aria-hidden="true">✳</span>
      <p>Life is short.<br /><em>Have the cake.</em></p>
      <span class="note-small">AND THE EXTRA SLICE, TOO.</span>
    </section>

    <section class="order section-pad" id="order">
      <div class="section-kicker"><span>03</span><span>THE GOOD PART</span></div>
      <div class="order-grid">
        <div>
          <p class="eyebrow"><span class="eyebrow-line"></span> SOMETHING TO CELEBRATE?</p>
          <h2>Let's make<br />it <em>sweet.</em></h2>
        </div>
        <div class="order-copy">
          <p>Have a date in mind, a flavour you're curious about, or a cake idea you can't stop thinking about? Send a message and let's figure it out.</p>
          <a class="button button-dark" href="https://www.instagram.com/liabakes_sg/" target="_blank" rel="noopener noreferrer">Message LiaBakes <span aria-hidden="true">↗</span></a>
          <p class="order-small">For enquiries and current availability, reach out on Instagram.</p>
        </div>
      </div>
      <div class="order-bottom"><span>GOOD BAKES. GOOD DAYS.</span><span>SINGAPORE · EST. WITH LOVE</span></div>
    </section>
  </main>

  <footer class="site-footer">
    <a class="wordmark footer-wordmark" href="#top">lia<span>bakes</span><i>.</i></a>
    <p>A little something homemade.</p>
    <a href="https://www.instagram.com/liabakes_sg/" target="_blank" rel="noopener noreferrer">INSTAGRAM ↗</a>
    <span class="copyright">© {new Date().getFullYear()} LIABAKES SG</span>
  </footer>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap');

  :root {
    --ink: #27251f;
    --muted: #777267;
    --paper: #f8f5ed;
    --cream: #eee8d9;
    --butter: #e7c76f;
    --tomato: #b95036;
    --line: rgba(39,37,31,.18);
    --serif: 'DM Serif Display', Georgia, serif;
    --sans: 'DM Sans', Arial, sans-serif;
    --gutter: clamp(1.25rem, 6vw, 6.5rem);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 90px; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; }
  img { display: block; width: 100%; }
  .announcement { min-height: 31px; display:flex; align-items:center; justify-content:center; gap:1rem; padding:.35rem 1rem; background:var(--ink); color:#f7f1e5; font-size:.58rem; letter-spacing:.17em; font-weight:600; text-align:center; }
  .announcement-dot { color:var(--butter); font-size:.8rem; }
  .site-header { height:82px; display:flex; align-items:center; justify-content:space-between; padding:0 var(--gutter); border-bottom:1px solid var(--line); position:relative; z-index:20; background:var(--paper); }
  .wordmark { font-family:var(--serif); font-size:2rem; letter-spacing:-.08em; line-height:1; }
  .wordmark span { font-style:italic; color:var(--tomato); }
  .wordmark i { color:var(--tomato); font-style:normal; }
  .site-nav { display:flex; align-items:center; gap:clamp(1.5rem,4vw,4rem); font-size:.75rem; font-weight:600; }
  .site-nav > a:not(.nav-cta) { color:#5f5b52; transition:color .2s; }
  .site-nav > a:hover { color:var(--tomato); }
  .nav-cta { border:1px solid var(--ink); border-radius:99px; padding:.75rem 1.15rem; }
  .nav-cta span { margin-left:.7rem; }
  .menu-toggle { display:none; }
  .hero { min-height:min(760px,calc(100svh - 113px)); display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:clamp(2rem,6vw,7rem); padding:clamp(4rem,8vw,7.5rem) var(--gutter) 5rem; position:relative; }
  .hero-copy { max-width:600px; padding-bottom:1rem; }
  .eyebrow { display:flex; align-items:center; gap:.7rem; font-size:.62rem; letter-spacing:.19em; font-weight:700; color:var(--tomato); margin:0 0 1.5rem; }
  .eyebrow-line { width:27px; height:1px; background:var(--tomato); }
  h1,h2,p { margin-top:0; }
  .hero h1,.intro h2,.bakes h2,.order h2 { font-family:var(--serif); font-weight:400; letter-spacing:-.045em; }
  .hero h1 { font-size:clamp(4.3rem,8.5vw,8.3rem); line-height:.91; margin:0 0 1.8rem; }
  .hero h1 em,.intro h2 em,.bakes h2 em,.order h2 em { color:var(--tomato); font-weight:400; }
  .hero-description { color:var(--muted); font-size:clamp(.95rem,1.25vw,1.08rem); line-height:1.85; max-width:420px; margin-bottom:2rem; }
  .hero-actions { display:flex; align-items:center; gap:1.6rem; flex-wrap:wrap; }
  .button { display:inline-flex; align-items:center; gap:2rem; padding:1rem 1.3rem; font-size:.75rem; font-weight:700; transition:transform .2s,background .2s; }
  .button:hover { transform:translateY(-3px); }
  .button-dark { color:var(--paper); background:var(--ink); }
  .button-dark:hover { background:var(--tomato); }
  .text-link,.underlined-link { font-size:.72rem; font-weight:700; border-bottom:1px solid var(--ink); padding-bottom:.35rem; }
  .text-link span,.underlined-link span { margin-left:.4rem; }
  .hero-footnote { margin-top:clamp(3rem,7vw,6rem); color:var(--muted); font-size:.62rem; letter-spacing:.13em; text-transform:uppercase; }
  .asterisk { color:var(--tomato); font-size:1rem; margin-right:.55rem; }
  .hero-visual { position:relative; width:100%; max-width:590px; justify-self:end; }
  .hero-photo-wrap { position:relative; background:var(--cream); padding:1rem 1rem 3.6rem; transform:rotate(2deg); box-shadow:0 22px 55px rgba(44,37,25,.12); }
  .hero-photo { aspect-ratio:4/4.25; object-fit:cover; }
  .photo-stamp { position:absolute; right:-1.1rem; top:12%; width:104px; height:104px; border-radius:50%; background:var(--butter); color:var(--ink); display:flex; flex-direction:column; align-items:center; justify-content:center; font-family:var(--serif); font-size:1.05rem; line-height:1.05; transform:rotate(10deg); box-shadow:0 5px 20px rgba(39,37,31,.12); }
  .photo-stamp strong { font-weight:400; font-style:italic; }
  .photo-stamp i { font-style:normal; font-family:var(--sans); font-size:.8rem; margin-top:.2rem; }
  .hero-caption { display:flex; justify-content:space-between; padding:.9rem .1rem 0; color:var(--muted); font-size:.55rem; letter-spacing:.15em; }
  .hero-side-note { position:absolute; right:-2.6rem; bottom:17%; writing-mode:vertical-rl; color:var(--tomato); font-family:var(--serif); font-style:italic; font-size:.85rem; }
  .hero-index { position:absolute; bottom:2rem; left:var(--gutter); color:var(--muted); font-size:.6rem; letter-spacing:.15em; }
  .section-pad { padding:clamp(5rem,10vw,9rem) var(--gutter); }
  .section-kicker { display:flex; align-items:center; gap:1rem; color:var(--tomato); font-size:.6rem; letter-spacing:.18em; font-weight:700; }
  .section-kicker span:first-child { border:1px solid var(--tomato); width:27px; height:27px; border-radius:50%; display:grid; place-items:center; letter-spacing:0; }
  .intro { position:relative; background:var(--cream); overflow:hidden; }
  .intro-grid { display:grid; grid-template-columns:1fr 1fr; gap:clamp(2rem,8vw,9rem); align-items:center; margin-top:3rem; }
  .intro h2,.bakes h2,.order h2 { font-size:clamp(3.5rem,7vw,6.8rem); line-height:.98; margin:0; }
  .intro-copy { max-width:470px; }
  .intro-lead { font-family:var(--serif); font-size:clamp(1.35rem,2vw,1.8rem); line-height:1.35; margin-bottom:1.2rem; }
  .intro-copy > p:not(.intro-lead) { color:var(--muted); line-height:1.9; font-size:.88rem; margin-bottom:1.8rem; }
  .underlined-link { display:inline-block; }
  .intro-mark { position:absolute; right:2%; bottom:-8rem; color:rgba(185,80,54,.055); font-family:var(--serif); font-size:28rem; line-height:1; pointer-events:none; }
  .bakes { background:var(--paper); }
  .bakes-heading { display:flex; justify-content:space-between; align-items:end; gap:2rem; margin:2.8rem 0 3.5rem; }
  .bakes-heading > p { max-width:310px; color:var(--muted); font-size:.86rem; line-height:1.8; margin:0 0 .4rem; }
  .treat-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1.15rem; }
  .treat-card { min-width:0; }
  .treat-image { position:relative; display:block; overflow:hidden; background:var(--cream); }
  .treat-image img { aspect-ratio: .83; object-fit:cover; transition:transform .7s cubic-bezier(.2,.7,.2,1); }
  .treat-image:hover img { transform:scale(1.055); }
  .treat-number { position:absolute; top:.8rem; left:.8rem; width:28px; height:28px; border-radius:50%; display:grid; place-items:center; background:var(--paper); font-size:.6rem; font-weight:700; }
  .treat-arrow { position:absolute; bottom:.8rem; right:.8rem; width:36px; height:36px; display:grid; place-items:center; background:var(--butter); border-radius:50%; font-size:1rem; transition:transform .2s; }
  .treat-image:hover .treat-arrow { transform:rotate(45deg); }
  .treat-meta { display:flex; justify-content:space-between; align-items:baseline; gap:.5rem; padding-top:1rem; }
  .treat-meta h3 { font-family:var(--serif); font-size:1.25rem; font-weight:400; margin:0; }
  .treat-meta span { color:var(--tomato); font-size:.53rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; white-space:nowrap; }
  .treat-card > p { margin:.5rem 0 0; color:var(--muted); font-size:.76rem; line-height:1.7; }
  .menu-disclaimer { margin:3rem 0 0; padding-top:1.2rem; border-top:1px solid var(--line); color:var(--muted); font-size:.7rem; }
  .note-band { min-height:340px; background:var(--butter); display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; position:relative; padding:4rem 1rem; }
  .note-star { font-size:1.5rem; margin-bottom:1rem; }
  .note-band p { font-family:var(--serif); font-size:clamp(3.5rem,8vw,7rem); line-height:.95; letter-spacing:-.04em; margin:0; }
  .note-band p em { color:var(--tomato); }
  .note-small { margin-top:1.8rem; font-size:.57rem; font-weight:700; letter-spacing:.2em; }
  .order { background:var(--cream); }
  .order-grid { display:grid; grid-template-columns:1fr 1fr; gap:3rem; align-items:center; margin:3rem 0 5rem; }
  .order h2 { font-size:clamp(4.2rem,8vw,8rem); }
  .order-copy { max-width:420px; }
  .order-copy > p:first-child { color:var(--muted); line-height:1.9; font-size:.95rem; margin-bottom:1.8rem; }
  .order-small { margin:1.2rem 0 0; color:var(--muted); font-size:.68rem; }
  .order-bottom { display:flex; justify-content:space-between; border-top:1px solid var(--line); padding-top:1rem; color:var(--muted); font-size:.56rem; letter-spacing:.16em; }
  .site-footer { display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; padding:2rem var(--gutter); background:var(--ink); color:var(--paper); }
  .footer-wordmark { font-size:1.6rem; }
  .site-footer > p { margin:0; color:#c5bdad; font-family:var(--serif); font-style:italic; font-size:1rem; }
  .site-footer > a:not(.wordmark) { font-size:.6rem; letter-spacing:.14em; font-weight:700; }
  .copyright { color:#aaa294; font-size:.55rem; letter-spacing:.1em; }
  @media (min-width:1500px) { .hero { padding-left:max(var(--gutter),calc((100vw - 1400px)/2)); padding-right:max(var(--gutter),calc((100vw - 1400px)/2)); } }
  @media (max-width:900px) {
    .hero { gap:2.5rem; }
    .hero h1 { font-size:clamp(4rem,9vw,6rem); }
    .treat-grid { grid-template-columns:repeat(2,minmax(0,1fr)); row-gap:2.5rem; }
    .treat-image img { aspect-ratio:1.1; }
  }
  @media (max-width:650px) {
    .announcement { gap:.5rem; font-size:.48rem; letter-spacing:.1em; }
    .site-header { height:70px; }
    .wordmark { font-size:1.75rem; }
    .menu-toggle { display:flex; width:42px; height:42px; border:1px solid var(--line); border-radius:50%; flex-direction:column; align-items:center; justify-content:center; gap:5px; background:transparent; }
    .menu-toggle span { width:15px; height:1px; background:var(--ink); transition:transform .2s; }
    .menu-toggle[aria-expanded="true"] span:first-child { transform:translateY(3px) rotate(45deg); }
    .menu-toggle[aria-expanded="true"] span:last-child { transform:translateY(-3px) rotate(-45deg); }
    .site-nav { display:none; position:absolute; top:69px; left:0; right:0; padding:1.5rem var(--gutter) 2rem; background:var(--paper); border-bottom:1px solid var(--line); flex-direction:column; align-items:stretch; gap:1.2rem; }
    .site-nav.open { display:flex; }
    .site-nav > a { padding:.5rem 0; }
    .site-nav .nav-cta { text-align:center; padding:.85rem 1rem; }
    .hero { min-height:auto; grid-template-columns:1fr; padding-top:4.2rem; padding-bottom:5rem; gap:3rem; }
    .hero h1 { font-size:clamp(4.4rem,17vw,6.5rem); }
    .hero-description { max-width:360px; }
    .hero-footnote { margin-top:2.8rem; }
    .hero-visual { width:88%; justify-self:center; margin-right:1rem; }
    .hero-photo-wrap { padding:.65rem .65rem 2.8rem; }
    .photo-stamp { width:82px; height:82px; font-size:.9rem; right:-1.3rem; }
    .hero-side-note { right:-1.8rem; font-size:.7rem; }
    .hero-index { bottom:1.5rem; }
    .section-pad { padding-top:5rem; padding-bottom:5rem; }
    .intro-grid,.order-grid { grid-template-columns:1fr; gap:2rem; }
    .intro-grid { margin-top:2rem; }
    .intro h2,.bakes h2 { font-size:clamp(4rem,15vw,5.8rem); }
    .intro-mark { font-size:18rem; bottom:-5rem; }
    .bakes-heading { display:block; margin:2rem 0 2.5rem; }
    .bakes-heading > p { margin-top:1.2rem; }
    .treat-grid { gap:2rem .8rem; }
    .treat-image img { aspect-ratio:.82; }
    .treat-meta { display:block; }
    .treat-meta h3 { font-size:1.15rem; }
    .treat-meta span { display:block; margin-top:.25rem; }
    .treat-card > p { font-size:.7rem; }
    .note-band { min-height:280px; }
    .order-grid { margin:2rem 0 3.5rem; }
    .order h2 { font-size:clamp(4.8rem,18vw,7rem); }
    .order-bottom { gap:1rem; font-size:.48rem; }
    .site-footer { justify-content:center; text-align:center; flex-direction:column; padding:2.5rem 1rem; }
  }
  @media (prefers-reduced-motion:reduce) {
    *,*::before,*::after { scroll-behavior:auto !important; transition-duration:.01ms !important; animation-duration:.01ms !important; animation-iteration-count:1 !important; }
  }
</style>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.querySelector('.site-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation');
    nav?.classList.toggle('open', isOpen);
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open navigation');
      nav.classList.remove('open');
    });
  });
</script>
</Base>
